# Copy to .env.local and fill in your own values. Never commit .env.local.
# The app runs entirely without these (in-memory demo data, no auth, no email),
# so you can add them one at a time as you set each service up.

# --- Postgres / Supabase ---------------------------------------------------
# Connection string for the Postgres database (Supabase: Project → Connect).
# When set, the app switches from the in-memory data layer to real SQL.
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres

# Supabase project URL and anon key (Project → API). Client-safe.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server only, never exposed to the browser. Needed for
# privileged admin jobs (e.g. status changes that bypass RLS).
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) --------------------------------------------------------
# Create an API key and verify your own sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM="Rabeya Furniture <orders@your-domain.com>"
# Where new-order and low-stock alerts go (your shop inbox).
ORDER_ALERT_EMAIL=orders@your-domain.com

# --- Background jobs -------------------------------------------------------
# Shared secret for the /api/cron/* endpoints. Send it as
# "Authorization: Bearer <value>".
CRON_SECRET=

# --- Payments (optional — COD is the default) ------------------------------
# Only needed once you turn on online payment. Store credentials on the host.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
